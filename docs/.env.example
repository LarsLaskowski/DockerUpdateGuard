# Copy this file to .env and adjust the values before running docker compose.
#
#   cp .env.example .env
#
# .env stays next to the docker-compose*.yml file and is loaded automatically
# by "docker compose". Do not commit the real .env file.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=dockerupdateguard
POSTGRES_USER=dockerupdateguard
POSTGRES_PASSWORD=change-me

# --- Host names of the UI (recommended) ----------------------------------
# Protects the UI against DNS rebinding: requests whose host name is not
# listed are answered with "Bad Request - Invalid Hostname".
# List every name and every IP address used in the browser's address bar,
# separated by ";", without port (IPv6 in brackets, e.g. [::1]). IP addresses
# are not exempt, so localhost and 127.0.0.1 must be listed too.
# "*.example.lan" covers subdomains only, not example.lan itself.
# Behind a reverse proxy, list the host name the proxy forwards to the app.
# Left unset, every name is accepted and the UI stays open to DNS rebinding.
# The variable name is case-sensitive. Remove or comment out the line instead
# of leaving it empty: an empty value overrides an AllowedHosts of a mounted
# appsettings.json and accepts every name.
# AllowedHosts=dockerupdateguard.example.lan;192.168.10.20;localhost;127.0.0.1

# --- Docker socket access ------------------------------------------------
# GID of the "docker" group that owns /var/run/docker.sock on the host.
# Find it with:
#   stat -c '%g' /var/run/docker.sock
# On systems where the socket is owned by root:root (e.g. Synology DSM),
# the default of 0 already works and this value can be left as-is.
DOCKER_GID=0

# --- Docker Hub (optional) -----------------------------------------------
# Only needed for authenticated Docker Hub API access (higher rate limits,
# private repositories). Leave empty to use anonymous access.
DOCKERHUB_USERNAME=
DOCKERHUB_PAT=
