@page "/runtime-containers/{DockerInstanceId:guid}/{ContainerId}"

@using DockerUpdateGuard.Data.Entities

<PageTitle>Runtime Container Detail</PageTitle>

<MudStack Spacing="3" Class="page-shell">
    <div class="page-header">
        <div>
            <MudText Typo="Typo.overline" Class="page-eyebrow">Container drilldown</MudText>
            <MudText Typo="Typo.h3">Runtime Container Detail</MudText>
            <MudText Class="page-description">Inspect the current runtime image, available tag candidates, manual selection, and vulnerability state.</MudText>
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(_errorMessage) == false)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    @if (_loadState.ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_loadState.ErrorMessage</MudAlert>
    }
    else if (_detail is not null)
    {
        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h4">@_detail.ContainerName</MudText>
                <MudText Class="section-description">@_detail.DockerInstanceName</MudText>
            </div>

            <MudGrid Spacing="2" Class="details-grid">
                <MudItem xs="12" md="6">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Runtime image</span>
                        <span class="summary-value">@ImageReferenceFormatter.GetReference(_detail.ImageReference)</span>
                        @if (string.IsNullOrWhiteSpace(_detail.ResolvedVersionTag) == false)
                        {
                            <span class="table-secondary">@($"{_detail.CurrentTag} · {_detail.ResolvedVersionTag}")</span>
                        }
                        @if (ImageReferenceFormatter.GetFullDigest(_detail.ImageReference) is string currentDigest)
                        {
                            <MudTooltip Text="@currentDigest">
                                <span class="table-secondary">@("@" + ImageReferenceFormatter.GetShortDigest(_detail.ImageReference))</span>
                            </MudTooltip>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Runtime state</span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@_detail.RuntimeStatus</MudChip>
                        <span class="table-secondary">Observed @TimestampFormatter.Format(_detail.RecordedAtUtc)</span>
                        @if (string.IsNullOrWhiteSpace(_detail.ComposeProject) == false
                            || string.IsNullOrWhiteSpace(_detail.StackName) == false
                            || string.IsNullOrWhiteSpace(_detail.ServiceName) == false)
                        {
                            <span class="table-secondary">@($"{_detail.ComposeProject ?? _detail.StackName ?? "Standalone"} · {_detail.ServiceName ?? "No service label"}")</span>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Observed own image</span>
                        @if (_detail.LinkedObservedImageId is Guid observedImageId)
                        {
                            <MudLink Href="@($"/observed-images/{observedImageId}")" Class="table-link">@_detail.LinkedObservedImageName</MudLink>
                        }
                        else
                        {
                            <span class="table-secondary">No linked own image</span>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Update assessment</span>
                        <MudChip T="string" Size="Size.Small" Color="@GetUpdateStateColor(_detail.UpdateStatus)">@_detail.UpdateStatus</MudChip>
                        @if (string.IsNullOrWhiteSpace(_detail.AvailableUpdateVersionTag) == false)
                        {
                            <span class="table-secondary">@_detail.AvailableUpdateVersionTag</span>
                        }
                        @if (string.IsNullOrWhiteSpace(_detail.UpdateMessage) == false)
                        {
                            <span class="table-secondary">@_detail.UpdateMessage</span>
                        }
                    </MudPaper>
                </MudItem>
                @if (string.IsNullOrWhiteSpace(_detail.BaseRuntimeAlertSummary) == false)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="summary-card" Elevation="0">
                            <span class="summary-label">Base runtime</span>
                            <MudChip T="string" Size="Size.Small" Color="@GetBaseRuntimeAlertColor(_detail.LinkedObservedImageId.HasValue)">
                                @(_detail.LinkedObservedImageId.HasValue ? "Runtime warning" : "Runtime hint")
                            </MudChip>
                            <span class="table-secondary">@_detail.BaseRuntimeAlertSummary</span>
                            @if (string.IsNullOrWhiteSpace(_detail.BaseRuntimeAlertDetails) == false)
                            {
                                <span class="table-secondary">@_detail.BaseRuntimeAlertDetails</span>
                            }
                        </MudPaper>
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <VulnerabilityAssessmentCard Assessment="_detail.VulnerabilityAssessment" ShowCheckedAt="true" />
                </MudItem>
                @if (_detail.ActiveBaseImageVulnerabilityFindingCount > 0)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="summary-card" Elevation="0">
                            <span class="summary-label">Base image vulnerabilities</span>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Findings detected</MudChip>
                            <span class="table-secondary">@_detail.BaseImageVulnerabilitySummary</span>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @if (_availability is { IsShown: true })
        {
            <MudPaper Class="section-paper" Elevation="0">
                <div class="section-header">
                    <MudText Typo="Typo.h5">Container actions</MudText>
                    <MudText Class="section-description">Start, stop or restart this container through Portainer. Every action asks for confirmation and is recorded.</MudText>
                </div>

                <span class="table-secondary">@($"Runtime status as of the last runtime scan ({TimestampFormatter.Format(_detail.RecordedAtUtc)}); an action does not update it. Run \"Check image updates\" on Runtime Containers to refresh it.")</span>

                @if (_availability.IsCurrent == false || _availability.IsSupported == false || _availability.IsInProgress)
                {
                    <MudAlert Severity="@(_availability.IsCurrent == false || _availability.IsInProgress ? Severity.Info : Severity.Warning)" Dense="true">@_availability.Message</MudAlert>
                }
                else if (_availability.OfferedActions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No actions are available for this container.</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="2">
                        @foreach (var actionType in _availability.OfferedActions)
                        {
                            var offeredAction = actionType;

                            <MudButton Variant="@(offeredAction == ContainerActionType.StartContainer ? Variant.Filled : Variant.Outlined)"
                                       Color="@(offeredAction == ContainerActionType.StartContainer ? Color.Primary : Color.Error)"
                                       Disabled="@(_runningAction is not null)"
                                       OnClick="@(() => StartAction(offeredAction))">
                                @if (_runningAction == offeredAction && _runningActionRouteKey == RouteKey)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                @ContainerActionDisplayNames.GetDisplayName(offeredAction)
                            </MudButton>
                        }
                    </MudStack>
                }

                @if (_actionOutcome is not null)
                {
                    <MudAlert Severity="@(_actionOutcome.Status == ContainerActionStatus.Succeeded ? Severity.Success : Severity.Error)" Dense="true">@_actionOutcome.Message</MudAlert>
                }

                <MudText Typo="Typo.h6">Action history</MudText>
                @if (_detail.ActionHistory.Count == 0)
                {
                    <MudPaper Class="empty-state-panel" Elevation="0">
                        <MudText>No container actions yet.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudTable Items="_detail.ActionHistory" Hover="true" Dense="true" Breakpoint="Breakpoint.Md" Class="section-table">
                        <HeaderContent>
                            <MudTh>Action</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Requested</MudTh>
                            <MudTh>Completed</MudTh>
                            <MudTh>Requested by</MudTh>
                            <MudTh>Message</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Action">@context.Action</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@GetActionStatusColor(context.Status)">@context.Status</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Requested">@TimestampFormatter.Format(context.RequestedAtUtc)</MudTd>
                            <MudTd DataLabel="Completed">@(context.CompletedAtUtc is DateTimeOffset completedAtUtc ? TimestampFormatter.Format(completedAtUtc) : "—")</MudTd>
                            <MudTd DataLabel="Requested by">@context.RequestedBy</MudTd>
                            <MudTd DataLabel="Message">@context.Message</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Base image chain</MudText>
                <MudText Class="section-description">Resolved base-image lineage for the current runtime image, including vulnerability status.</MudText>
            </div>
            @if (_detail.BaseImages.Count == 0)
            {
                <MudPaper Class="empty-state-panel" Elevation="0">
                    <MudText>No base image chain is currently stored for this runtime image.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="_detail.BaseImages" Hover="true" Dense="false" Breakpoint="Breakpoint.Md" Class="section-table">
                    <HeaderContent>
                        <MudTh>Depth</MudTh>
                        <MudTh>Base Image</MudTh>
                        <MudTh>Source</MudTh>
                        <MudTh>Vulnerabilities</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Depth">@context.Depth</MudTd>
                        <MudTd DataLabel="Base Image">@ImageReferenceFormatter.GetReference(context.ImageReference)</MudTd>
                        <MudTd DataLabel="Source">@ImageReferenceFormatter.GetReference(context.SourceReference ?? string.Empty)</MudTd>
                        <MudTd DataLabel="Vulnerabilities">
                            <MudChip T="string" Size="Size.Small" Color="@VulnerabilityDisplayFormatter.GetStatusColor(context.VulnerabilityAssessment.Status, context.VulnerabilityAssessment.SeveritySummary)">@context.VulnerabilityAssessment.Status</MudChip>
                            <VulnerabilitySeverityChips Summary="context.VulnerabilityAssessment.SeveritySummary" />
                            <span class="table-secondary">@($"{context.VulnerabilityAssessment.ActiveFindingCount} active · {context.VulnerabilityAssessment.Source}")</span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Resource usage</MudText>
                <MudText Class="section-description">Current RAM/CPU/network usage and recent history for this container.</MudText>
            </div>
            <MudGrid Spacing="2" Class="details-grid">
                <MudItem xs="6" sm="6" md="4">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">CPU</span>
                        <span class="summary-value">@FormatCpu(_detail.CurrentResourceUsage)</span>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="6" md="4">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Memory</span>
                        <span class="summary-value">@FormatMemory(_detail.CurrentResourceUsage)</span>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="6" md="4">
                    <MudPaper Class="summary-card" Elevation="0">
                        <span class="summary-label">Network</span>
                        <span class="summary-value">@FormatNetwork(_detail.CurrentResourceUsage)</span>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_detail.ResourceUsageHistory.Count == 0)
            {
                <MudPaper Class="empty-state-panel" Elevation="0">
                    <MudText>No resource history is currently stored for this container.</MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid Spacing="2" Class="details-grid">
                    <MudItem xs="12" lg="6">
                        <MudPaper Class="summary-card" Elevation="0">
                            <span class="summary-label">CPU history</span>
                            <div class="dug-chart">
                                <MudChart ChartType="ChartType.Line"
                                          ChartSeries="@ResourceUsageChartBuilder.GetCpuSeries(_detail.ResourceUsageHistory)"
                                          ChartLabels="@ResourceUsageChartBuilder.GetChartLabels(_detail.ResourceUsageHistory, 5)"
                                          Height="100%"
                                          Width="100%"
                                          MatchBoundsToSize="true" />
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" lg="6">
                        <MudPaper Class="summary-card" Elevation="0">
                            <span class="summary-label">Memory history</span>
                            <div class="dug-chart">
                                <MudChart ChartType="ChartType.Line"
                                          ChartSeries="@ResourceUsageChartBuilder.GetMemorySeries(_detail.ResourceUsageHistory)"
                                          ChartLabels="@ResourceUsageChartBuilder.GetChartLabels(_detail.ResourceUsageHistory, 5)"
                                          Height="100%"
                                          Width="100%"
                                          MatchBoundsToSize="true" />
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudPaper Class="summary-card" Elevation="0">
                            <span class="summary-label">Network history</span>
                            <div class="dug-chart">
                                <MudChart ChartType="ChartType.Line"
                                          ChartSeries="@ResourceUsageChartBuilder.GetNetworkSeries(_detail.ResourceUsageHistory)"
                                          ChartLabels="@ResourceUsageChartBuilder.GetChartLabels(_detail.ResourceUsageHistory, 8)"
                                          Height="100%"
                                          Width="100%"
                                          MatchBoundsToSize="true" />
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Manual tag preference</MudText>
                <MudText Class="section-description">Persist a preferred tag recommendation without triggering any rollout.</MudText>
            </div>

            @if (string.IsNullOrWhiteSpace(_detail.ManualSelectionImage))
            {
                <MudPaper Class="empty-state-panel" Elevation="0">
                    <MudText>No manual tag preference is stored for this container.</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Selected</MudChip>
                    <MudText>@_detail.ManualSelectionImage</MudText>
                    @if (_detail.ManualSelectionAtUtc is DateTimeOffset selectedAtUtc)
                    {
                        <MudText Class="table-secondary">Saved @TimestampFormatter.Format(selectedAtUtc)</MudText>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Disabled="@_isBusy"
                               OnClick="ClearSelectionAsync">
                        Clear selection
                    </MudButton>
                </MudStack>
            }
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Available tag candidates</MudText>
                <MudText Class="section-description">Choose one of the persisted scan candidates as the manual preference.</MudText>
            </div>
            @if (_detail.UpdateFindings.Any(finding => finding.IsActive) && _detail.VulnerabilityAssessment.FixableFindingCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@($"Updating may resolve up to {_detail.VulnerabilityAssessment.FixableFindingCount} of {_detail.VulnerabilityAssessment.ActiveFindingCount} active findings")</MudChip>
            }

            @if (_detail.AvailableTagCandidates.Count == 0)
            {
                <MudPaper Class="empty-state-panel" Elevation="0">
                    <MudText>No tag candidates are currently stored for this container.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="_detail.AvailableTagCandidates" Hover="true" Dense="false" Breakpoint="Breakpoint.Md" Class="section-table">
                    <HeaderContent>
                        <MudTh>Tag</MudTh>
                        <MudTh>Digest</MudTh>
                        <MudTh>Reason</MudTh>
                        <MudTh>Published</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tag">
                            <MudStack Spacing="1">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(context.IsRecommended ? Color.Primary : Color.Default)"
                                         Variant="@(context.IsSelected ? Variant.Filled : Variant.Outlined)">
                                    @context.Tag
                                </MudChip>
                                @if (string.IsNullOrWhiteSpace(context.ResolvedVersionTag) == false)
                                {
                                    <span class="table-secondary">@context.ResolvedVersionTag</span>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Digest">
                            @if (string.IsNullOrWhiteSpace(context.Digest))
                            {
                                <span class="table-secondary">No digest</span>
                            }
                            else
                            {
                                <MudTooltip Text="@context.Digest">
                                    <span>@ImageReferenceFormatter.GetShortDigest($"image:tag@{context.Digest}")</span>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Reason">@context.Reason</MudTd>
                        <MudTd DataLabel="Published">@TimestampFormatter.FormatOptional(context.PublishedAtUtc)</MudTd>
                        <MudTd DataLabel="Action">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Disabled="@_isBusy"
                                       OnClick="@(() => SaveSelectionAsync(context.Tag, context.Digest))">
                                @(context.IsSelected ? "Saved" : "Select")
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Update findings</MudText>
                <MudText Class="section-description">The raw update findings behind the current assessment.</MudText>
            </div>

            @if (_detail.UpdateFindings.Count == 0)
            {
                <MudPaper Class="empty-state-panel" Elevation="0">
                    <MudText>No update findings are currently stored for this container.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="_detail.UpdateFindings" Hover="true" Dense="false" Breakpoint="Breakpoint.Md" Class="section-table">
                    <HeaderContent>
                        <MudTh>Type</MudTh>
                        <MudTh>Summary</MudTh>
                        <MudTh>Recommended</MudTh>
                        <MudTh>Tag candidates</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Type">@context.Type</MudTd>
                        <MudTd DataLabel="Summary">
                            <span>@context.Summary</span>
                            <span class="table-secondary">@context.Details</span>
                        </MudTd>
                        <MudTd DataLabel="Recommended">@context.RecommendedImage</MudTd>
                        <MudTd DataLabel="Tag candidates">
                            <MudStack Row="true" Spacing="1">
                                @foreach (var candidate in context.TagCandidates)
                                {
                                    <MudTooltip Text="@candidate.Reason">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@(candidate.IsRecommended ? Color.Primary : Color.Default)"
                                     Variant="@(candidate.IsSelected ? Variant.Filled : Variant.Outlined)">
                                            @candidate.Tag
                                        </MudChip>
                                    </MudTooltip>
                                    @if (string.IsNullOrWhiteSpace(candidate.ResolvedVersionTag) == false)
                                    {
                                        <span class="table-secondary">@candidate.ResolvedVersionTag</span>
                                    }
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Vulnerability findings</MudText>
                <MudText Class="section-description">Current security findings for the runtime image.</MudText>
            </div>

            <VulnerabilityFindingsTable Findings="_detail.VulnerabilityFindings" />
        </MudPaper>

        <MudPaper Class="section-paper" Elevation="0">
            <div class="section-header">
                <MudText Typo="Typo.h5">Scan history</MudText>
                <MudText Class="section-description">Recent runtime scans that touched this container.</MudText>
            </div>
            <MudTable Items="_detail.ScanHistory" Hover="true" Dense="false" Breakpoint="Breakpoint.Md" Class="section-table">
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Trigger</MudTh>
                    <MudTh>Started</MudTh>
                    <MudTh>Error</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetScanStatusColor(context.Status)">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Trigger">@context.TriggerSource</MudTd>
                    <MudTd DataLabel="Started">@TimestampFormatter.Format(context.StartedAtUtc)</MudTd>
                    <MudTd DataLabel="Error">@context.ErrorMessage</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
    else if (_loadState.IsNotFound)
    {
        <MudPaper Class="empty-state-panel" Elevation="0">
            <MudText>This container is not known on this Docker instance.</MudText>
            <MudLink Href="/runtime-containers">Back to Runtime Containers</MudLink>
        </MudPaper>
    }
    else
    {
        <TableSkeleton Rows="6" />
    }
</MudStack>
