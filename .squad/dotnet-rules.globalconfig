# The rules the .NET rule baseline switches off for every C# file, as a global analyzer config:
# an .editorconfig section reaches no generated code (Razor components), this file reaches every syntax tree of the
# compilation. Directory.Build.props names it in GlobalAnalyzerConfigFiles (dotnet_config.py checks it). Written by
# the template's tools/dotnet-baseline.py from dotnet-rules.editorconfig; never edit it in a repository.
is_global = true

dotnet_diagnostic.RH2102.severity = none

dotnet_diagnostic.RH4124.severity = none

dotnet_diagnostic.RH7004.severity = none

dotnet_diagnostic.RH8027.severity = none

dotnet_diagnostic.RH8306.severity = none

# == false is the binding style; off in the source, since the built-in Sonar way comprehensive profile of SonarQube Cloud cannot switch it off (#338)
dotnet_diagnostic.S1125.severity = none
